# Build context hygiene — keep images small and secrets out of layers

# Git / IDE
.git
.gitignore
.gitattributes
.idea
.vscode
*.md
!README.md

# Docs live at monorepo root — never needed in the API image
docs

# Dependencies & build output (rebuilt inside the image)
node_modules
dist
coverage
.nyc_output

# Env & secrets (injected at runtime via compose / orchestrator)
.env
.env.*
!.env.docker.example
*.pem
*.key

# Tests — not required for production runtime
test
**/*.spec.ts
**/*.e2e-spec.ts
jest.config.*

# Tooling / local artifacts
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache
.prettier*
eslint.config.*
tsconfig.build.tsbuildinfo
*.tsbuildinfo

# Docker (avoid recursive context surprises)
Dockerfile*
docker-compose*.yml
.dockerignore

# OS junk
.DS_Store
Thumbs.db
