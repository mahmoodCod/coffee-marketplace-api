############################################
# Docker environment template
############################################
# Copy this file and fill in real secrets:
#   cp .env.docker.example .env.docker
#
# Never commit .env.docker with production credentials.
############################################

NODE_ENV=production
PORT=3000

# Published host ports (local stack)
API_PUBLISH_PORT=3000
POSTGRES_PUBLISH_PORT=5432
REDIS_PUBLISH_PORT=6379
NGINX_PUBLISH_PORT=80

# Database (hostnames postgres/redis are overridden inside Compose)
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=coffee_marketplace
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=change-me-strong-db-password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379

# JWT — must be at least 32 characters (Joi validation)
JWT_ACCESS_SECRET=change-me-coffee-marketplace-access-secret-32chars
JWT_REFRESH_SECRET=change-me-coffee-marketplace-refresh-secret-32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRES_IN=120

# Optional providers (leave empty for mock/local)
SMS_API_KEY=
SMS_SENDER=

# Boot behaviour
# First bring-up: RUN_SEEDS=true to insert system roles
# Subsequent / production: RUN_SEEDS=false
RUN_MIGRATIONS=true
RUN_SEEDS=true

NODE_VERSION=20.19.0
